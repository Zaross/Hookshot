DATABASE_URL=sqlite:data/app.db
# TCP port the HTTP server listens on.
PORT=8080

# If running behind a reverse proxy that maps a host port to the container,
# set HOST_PORT to the external port (used for documentation / reference only).
HOST_PORT=8080

# Directory containing the compiled frontend assets (Vite dist output).
FRONTEND_DIR=frontend/dist

# Log level filter for tracing / tower-http.
# Format: <crate>=<level>[,<crate>=<level>...]
# Examples: debug | hookshot=debug,tower_http=info | error
RUST_LOG=hookshot=info,tower_http=info

# Log output format. Set to "json" for structured JSON logs (recommended for
# log aggregation systems like Loki, Datadog, etc.). Omit for human-readable text.
# LOG_FORMAT=json

# Cross-Origin Resource Sharing (CORS).
# Leave unset (default) — the frontend is served from the same origin as the
# API, so CORS headers are not needed for normal use.
# Set this only if you need to call the API from a *different* domain (e.g.
# an external dashboard or integration).
# Must be a single fully-qualified origin: https://dashboard.example.com
# CORS_ORIGIN=https://your-external-domain.com

# ──────────────────────────────────────────────────────────────────────────────
# The following values are stored in the database and managed automatically;
# you do not normally need to set them here.
# ──────────────────────────────────────────────────────────────────────────────

# Override the auto-generated JWT signing secret (32+ random bytes, hex or base64).
# Leave unset to let the application generate and persist one in the database.
# JWT_SECRET=your_very_long_random_secret_here
